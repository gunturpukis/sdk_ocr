[TEMPLATE]
# Salin ke .env dan isi sesuai kebutuhan Anda

PORT=3000

# CORS whitelist untuk origin DOKUMEN IFRAME (domain hosting apps/web_host
# Flutter web — BUKAN domain React/Next.js yang meng-embed-nya). Pisahkan
# dengan koma, origin exact tanpa trailing slash. Kosong = hanya localhost
# diizinkan (dev). Contoh:
# CORS_ALLOWED_ORIGINS=https://scan.yourapp.com,https://host.yourapp.com
CORS_ALLOWED_ORIGINS=

# API key yang divalidasi terhadap header Authorization: Bearer <key>
# dari OcrClient (Flutter). Ganti dengan key acak yang kuat untuk
# production — jangan pakai contoh ini.
OCR_API_KEY=ganti-dengan-api-key-anda-sendiri

# URL model .ort tier "medium" — pakai file yang sama yang sudah
# Anda upload ke R2 (model-ocr bucket), BUKAN URL GitHub LFS langsung
# (ingat pelajaran soal bandwidth quota GitHub LFS dari histori
# debugging sebelumnya — sama pentingnya di sisi server).
MODEL_DET_URL=https://pub-c8c8b842ca5f4ffa88109b25a0df16f4.r2.dev/det-medium.ort
MODEL_REC_URL=https://pub-c8c8b842ca5f4ffa88109b25a0df16f4.r2.dev/rec-medium.ort
MODEL_DICT_URL=https://pub-c8c8b842ca5f4ffa88109b25a0df16f4.r2.dev/dict.txt

# Confidence threshold minimal (0-100) sebelum dianggap "gagal" —
# beda dari threshold di client, ini murni untuk keputusan
# success:true/false di response cloud
MIN_CONFIDENCE=50
